# AI/agent tool directories
# Only tools whose output no repo ever commits. Anything a repo may track
# (.claude/, .mcp.json, AGENTS.md, CLAUDE*.md) belongs in that repo's
# .git/info/exclude instead: a global ignore hides new files from git status
# and makes `git add` refuse them without -f.
.agent-browser/
.llm/
.opencode/
.playwright-mcp/

# AI/agent tool files
.skill-lock.json

# Local-only notes. The .local. suffix means the file is never shared, so no
# repo tracks one and the ignore cannot hide a tracked path.
*.local.md

# Local git config (machine-specific identities)
.gitconfig-github
.gitconfig-gitlab
.gitconfig.local
