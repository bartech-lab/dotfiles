{
  "workbench.startupEditor": "none",
  "gitlens.ai.model": null,
  "gitlens.ai.vscode.model": null,
  "github.copilot.chat.enabled": false,
  "github.copilot.chat.enable": false,
  "chat.commandCenter.enabled": false,
  "chat.agent.enabled": false,
  "chat.editing.enabled": false,
  "chat.enabled": false,
  "workbench.experimental.chat.enabled": false,
  "inlineChat.enabled": false,
  "editor.inlineSuggest.enabled": false,
  "terminal.integrated.suggest.enabled": false,
  "github.copilot.enable": {
    "*": false
  },
  "workbench.activityBar.location": "default",
  "chat.viewContainer.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.panel.defaultLocation": "bottom",
  "files.autoSave": "afterDelay",
  "chat.disableAIFeatures": true,
  "files.maxMemoryForLargeFilesMB": 2048,
  "editor.largeFileOptimizations": true,
  "editor.maxTokenizationLineLength": 20000,
  "editor.smoothScrolling": false,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.matchBrackets": "never",
  "editor.folding": false,
  "editor.codeLens": false,
  "editor.links": false,
  "editor.parameterHints.enabled": false,
  "editor.hover.enabled": "off",
  "editor.lightbulb.enabled": "off",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.list.smoothScrolling": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 5,
  "workbench.editor.limit.perEditorGroup": true,
  "search.followSymlinks": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true
  },
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "extensions.ignoreRecommendations": true,
  "git.autorefresh": false,
  "git.autofetch": true,
  "telemetry.telemetryLevel": "off",
  "git.autofetchPeriod": 60,
  "git.confirmSync": false,
  "explorer.confirmDelete": false,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true,
  "editor.minimap.renderCharacters": false,
  "terminal.integrated.smoothScrolling": false,
  "github.copilot.chat.organizationInstructions.enabled": false,
  "github.copilot.chat.organizationCustomAgents.enabled": false,
  "chat.titleBar.signIn.enabled": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "editor.accessibilitySupport": "off",
  "editor.fontSize": 16,
  "terminal.integrated.fontSize": 15,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}
