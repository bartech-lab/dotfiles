[Desktop Entry]
Name=Standard Notes
Exec=env DESKTOPINTEGRATION=false ELECTRON_ENABLE_STACK_DUMPING=false /usr/bin/standard-notes --enable-features=UseOzonePlatform --ozone-platform=wayland --disable-gpu --js-flags=--max-old-space-size=256 --process-per-site --disable-extensions --disable-background-networking --enable-low-end-device-mode %U
Terminal=false
Type=Application
Icon=standard-notes
StartupWMClass=standard notes
Comment=An end-to-end encrypted notes app for digitalists and professionals.
MimeType=x-scheme-handler/standardnotes;
Categories=Office;
