#!/bin/bash
# Start ComfyUI in its own memory scope, outside the terminal's cgroup.
# A ComfyUI run inside WezTerm counts against WezTerm's memory cap and trips wezterm-mem-guard.
# Over COMFYUI_MEM (default 32G) only ComfyUI is killed. Extra arguments go to main.py.
# --collect: a scope killed for memory is removed, so the next start can reuse the name.
# --disable-pinned-memory: pinned (locked) RAM cannot be reclaimed and made up most of the measured 29-31 GB peaks.
# Game mode frees the GPU (Bonsai holds about 12 GB of 16). If this script turned it on, it turns it off when
# ComfyUI exits; if game mode was already on, it stays on.
set -euo pipefail
cd "$HOME/Projects/faceswap/ComfyUI"

ours=0
status=$(gaming status) || true
if [[ "$status" != 'Game mode on'* ]]; then
    gaming on
    ours=1
fi
trap '[ "$ours" = 1 ] && gaming off' EXIT
trap ':' INT  # Ctrl+C stops ComfyUI (it handles SIGINT); the script lives on to run the EXIT trap

systemd-run --user --scope --collect --unit=comfyui --description="ComfyUI in its own memory scope" \
    -p MemoryMax="${COMFYUI_MEM:-32G}" -p MemorySwapMax=0 \
    .venv/bin/python main.py --disable-pinned-memory "$@" || rc=$?
# Ctrl+C (130) is the normal way to stop it; any other failure keeps its exit code.
[ "${rc:-0}" = 130 ] && rc=0
exit "${rc:-0}"
