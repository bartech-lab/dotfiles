#!/usr/bin/env bash
# Daily check after a Curve Optimizer change: CPU hardware errors (MCE) and
# boots that ended without a clean shutdown (crash, freeze, hard reset).
set -uo pipefail

boots=${1:-10}
problems=0

echo "== CPU hardware errors (MCE) per boot, last $boots boots =="
journalctl --list-boots --no-pager -q | tail -n "$boots" | while read -r idx _id rest; do
  n=$(journalctl -k -b "$idx" --no-pager -q 2>/dev/null |
    grep -ciE 'machine check events logged|mce: \[hardware error\]')
  clean=yes
  if [[ $idx != 0 ]]; then
    tail_log=$(journalctl -b "$idx" --no-pager -q -n 300 2>/dev/null)
    grep -qE 'reboot: (Power down|Restarting system)|Journal stopped|Reached target (System Power Off|System Reboot)' <<<"$tail_log" || clean=NO
  else
    clean="(running)"
  fi
  flag=""
  [[ $n -gt 0 || $clean == NO ]] && flag="  <-- check"
  printf 'boot %4s  %s  mce=%s  clean-shutdown=%s%s\n' "$idx" "${rest:0:40}" "$n" "$clean" "$flag"
done

echo
echo "== latest MCE lines (all boots) =="
journalctl -k --no-pager -q 2>/dev/null | grep -iE 'mce: \[hardware error\]' | tail -8 || true
if journalctl -k --no-pager -q 2>/dev/null | grep -qiE 'mce: \[hardware error\]'; then
  problems=1
  echo "-> 'CPU N' in these lines names the logical CPU; cpu N and N+8 are the same core."
else
  echo "(none)"
fi
exit $problems
