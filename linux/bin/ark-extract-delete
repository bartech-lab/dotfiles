#!/bin/bash
status=0
for archive in "$@"; do
    dir=$(dirname -- "$archive")
    before=$(ls -A -- "$dir")
    if ark --batch --autodestination --autosubfolder -- "$archive" && [[ $(ls -A -- "$dir") != "$before" ]]; then
        rm -f -- "$archive"
    else
        echo "ark-extract-delete: kept $archive (extraction failed or produced nothing)" >&2
        status=1
    fi
done
exit $status
