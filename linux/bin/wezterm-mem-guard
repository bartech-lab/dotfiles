#!/usr/bin/python3 -I
"""Stop a memory leak inside WezTerm before it reaches the unit's MemoryHigh throttle.

WezTerm runs in its own systemd unit, and every agent session and test run lives in that cgroup.
The guard reads the cgroup's anonymous memory against its memory.high every few seconds:
  75% of memory.high: an ops alert, once per episode.
  90% of memory.high: kill every headless Chromium in WezTerm and its child processes (leaked test browsers
                      are the known cause).
                      With none left, kill nothing: alert once, naming the largest process and how to stop it.
Every kill sends an ops alert naming what was killed and why. Nothing else is ever killed, because any other
process may be a parallel session's live work (AGENTS.md emergency-guard exception).
--once runs one check and exits (manual use); --ticks N runs N rounds with no sleep (tests). WEZTERM_MEM_GUARD_ROOT overrides the cgroup root.
"""
import glob
import os
import signal
import subprocess
import sys
import time

ROOT = os.environ.get(
    "WEZTERM_MEM_GUARD_ROOT",
    f"/sys/fs/cgroup/user.slice/user-{os.getuid()}.slice/user@{os.getuid()}.service/app.slice")
UNIT_GLOB = "app-org.wezfurlong.wezterm@*.service"
WARN, ACT = 75, 90
PROTECTED = {"claude", "zsh", "bash", "sh", "fish", "wezterm-gui", "wezterm-mux-server", "wezterm",
             "ssh", "sshd", "tmux", "systemd", "nvim", "vim"}
INTERVAL, COOLDOWN = 5, 15
TITLES = {"warn": "WezTerm memory is high", "critical": "WezTerm memory is critical, nothing killed",
          "act": "WezTerm memory guard acted"}
PRIORITY = {"warn": "3", "critical": "5", "act": "4"}
RANK = {"warn": 1, "critical": 2}


def read(path):
    with open(path) as f:
        return f.read()


def anon_bytes(cg):
    for line in read(os.path.join(cg, "memory.stat")).splitlines():
        key, value = line.split()
        if key == "anon":
            return int(value)
    return 0


def high_bytes(cg):
    value = read(os.path.join(cg, "memory.high")).strip()
    return None if value == "max" else int(value)


def pids(cg):
    found = []
    for dirpath, _, files in os.walk(cg):
        if "cgroup.procs" in files:
            found += [int(p) for p in read(os.path.join(dirpath, "cgroup.procs")).split()]
    return found


def proc(pid):
    try:
        argv = read(f"/proc/{pid}/cmdline").split("\0")
        comm = read(f"/proc/{pid}/comm").strip()
        ppid = int(read(f"/proc/{pid}/stat").rsplit(")", 1)[1].split()[1])
        rss = int(read(f"/proc/{pid}/statm").split()[1]) * os.sysconf("SC_PAGE_SIZE")
    except (OSError, IndexError, ValueError):
        return None
    return {"pid": pid, "ppid": ppid, "argv": [a for a in argv if a], "comm": comm, "rss": rss}


def headless_chromium(p):
    words = " ".join(p["argv"]).split()
    first = os.path.basename(words[0]) if words else ""
    return "chrom" in (first + " " + p["comm"]).lower() and any(w.startswith("--headless") for w in words)


def headless_trees(procs):
    """Headless Chromium processes plus every descendant in the cgroup: renderers carry no --headless flag."""
    children = {}
    for p in procs:
        children.setdefault(p["ppid"], []).append(p)
    found, todo = {}, [p for p in procs if headless_chromium(p)]
    while todo:
        p = todo.pop()
        if p["pid"] not in found:
            found[p["pid"]] = p
            todo += children.get(p["pid"], [])
            parent = proc(p["ppid"])
            if parent and headless_chromium(parent):
                todo.append(parent)
    return list(found.values())


def kill(pid):
    try:
        os.kill(pid, signal.SIGKILL)
        return True
    except OSError:
        return False


def gib(n):
    return f"{n / 1073741824:.1f} GiB"


def notify(title, message, priority="4"):
    try:
        subprocess.run([os.path.expanduser("~/.local/bin/ops"), "notify", title, message, "--priority", priority],
                       timeout=20, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        print("ops notify failed:", e, file=sys.stderr)


def check(cg):
    """Return (level, message) for one WezTerm cgroup and kill when it is at the ACT level."""
    high = high_bytes(cg)
    if not high:
        return "ok", ""
    anon = anon_bytes(cg)
    usage = f"{gib(anon)} of the {gib(high)} limit"
    if anon * 100 < WARN * high:
        return "ok", usage
    if anon * 100 < ACT * high:
        return "warn", f"WezTerm uses {usage}. At {ACT}% the guard kills headless Chromium."
    procs = [p for p in map(proc, pids(cg)) if p]
    browsers = headless_trees(procs)
    if browsers:
        killed = [p for p in browsers if kill(p["pid"])]
        return "act", f"WezTerm used {usage}. Killed {len(killed)} headless Chromium processes ({gib(sum(p['rss'] for p in killed))})."
    candidates = [p for p in procs if p["comm"] not in PROTECTED]
    if not candidates:
        return "critical", f"WezTerm uses {usage}, mostly shells, terminals or Claude sessions. Nothing was killed."
    top = max(candidates, key=lambda p: p["rss"])
    return "critical", (f"WezTerm uses {usage}. Nothing was killed. Largest: PID {top['pid']} "
                        f"{' '.join(top['argv'])[:120]} ({gib(top['rss'])}). Stop it with: kill {top['pid']}")


def units():
    return sorted(glob.glob(os.path.join(ROOT, UNIT_GLOB)) + glob.glob(os.path.join(ROOT, "*.slice", UNIT_GLOB)))


def tick(alerted):
    """One round over every WezTerm unit. Every kill alerts; a warn or critical alerts once until memory is ok again."""
    acted = False
    for cg in units():
        try:
            level, message = check(cg)
        except OSError:
            continue
        if level == "act":
            notify(TITLES[level], message, PRIORITY[level])
            acted = True
        elif level in TITLES and RANK[level] > alerted.get(cg, 0):
            notify(TITLES[level], message, PRIORITY[level])
            alerted[cg] = RANK[level]
        elif level == "ok":
            alerted.pop(cg, None)
    return acted


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print("usage: wezterm-mem-guard [--once]\n" + __doc__)
        return
    if "--once" in sys.argv:
        for cg in units():
            try:
                level, message = check(cg)
            except OSError:
                continue
            print(level, message)
            if level in TITLES:
                notify(TITLES[level], message, PRIORITY[level])
        return
    alerted = {}
    if "--ticks" in sys.argv:
        for _ in range(int(sys.argv[sys.argv.index("--ticks") + 1])):
            tick(alerted)
            print("tick", flush=True)
            input()
        return
    while True:
        time.sleep(COOLDOWN if tick(alerted) else INTERVAL)


if __name__ == "__main__":
    main()
