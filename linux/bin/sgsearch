#!/usr/bin/env python3
"""Code search across ~2M public repos via Sourcegraph's public streaming API. No auth needed.

Usage:  sgsearch '<query>'
Example: sgsearch 'lang:TypeScript useSyncExternalStore count:20'
         sgsearch 'repo:facebook/react patch:.*useSyncExternal type:file'
Query syntax: https://docs.sourcegraph.com/code_search/reference/queries
"""
import json
import sys
import urllib.parse
import urllib.request

API = "https://sourcegraph.com/.api/search/stream"


def main() -> int:
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        print("usage: sgsearch '<sourcegraph query>'", file=sys.stderr)
        return 2

    query = sys.argv[1]
    if "context:" not in query:
        query = "context:global " + query

    url = API + "?" + urllib.parse.urlencode({"q": query})
    req = urllib.request.Request(
        url,
        headers={"Accept": "text/event-stream", "User-Agent": "sgsearch/1.0"},
    )

    found = 0
    with urllib.request.urlopen(req, timeout=45) as resp:
        for raw in resp:
            line = raw.decode("utf-8", "replace")
            if not line.startswith("data: "):
                continue
            try:
                payload = json.loads(line[6:])
            except ValueError:
                continue
            if not isinstance(payload, list):
                continue
            for match in payload:
                if match.get("type") != "content":
                    continue
                repo = match.get("repository", "").replace("github.com/", "")
                path = match.get("path", "")
                for chunk in match.get("chunkMatches") or []:
                    lines = (chunk.get("content") or "").splitlines()
                    number = chunk.get("contentStart", {}).get("line", 0) + 1
                    text = lines[0].strip() if lines else ""
                    print(f"{repo}/{path}:{number}: {text[:120]}")
                    found += 1
                for hit in match.get("lineMatches") or []:
                    number = hit.get("lineNumber", 0) + 1
                    text = hit.get("line", "").strip()
                    print(f"{repo}/{path}:{number}: {text[:120]}")
                    found += 1

    if not found:
        print("no matches", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
