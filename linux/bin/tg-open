#!/usr/bin/env python3
"""Open a tg:// link in the Telegram Web A Brave app, keeping one window."""
import os
import subprocess
import sys
import tempfile
import time
from urllib.parse import quote

APP_ID = "ibblmnobmgdmpoeblocemifbpglakpoi"
WINDOW_CLASS = f"brave-{APP_ID}-Default"
BRAVE = ["/opt/brave-bin/brave", "--profile-directory=Default", f"--app-id={APP_ID}"]
SWAP_TIMEOUT_S = 15

# Brave has no route into a running app window, so every link opens a new
# window. KWin closes the previous ones as soon as the new window appears.
KWIN_SWAP = """
var cls = "%s";
var old = workspace.windowList().filter(function (w) { return w.resourceClass == cls; });
var done = false;
workspace.windowAdded.connect(function (w) {
    if (done || w.resourceClass != cls) return;
    done = true;
    old.forEach(function (o) { o.closeWindow(); });
    workspace.activeWindow = w;
});
""" % WINDOW_CLASS


def web_url(link):
    return "https://web.telegram.org/a/#?tgaddr=" + quote(link, safe="")


def qdbus(*args):
    done = subprocess.run(["qdbus6", "org.kde.KWin", *args], capture_output=True, text=True)
    return done.stdout.strip()


def main():
    if len(sys.argv) < 2:
        os.execv(BRAVE[0], BRAVE)

    launch = [*BRAVE, f"--app-launch-url-for-shortcuts-menu-item={web_url(sys.argv[1])}"]
    name = f"tg-open-{os.getpid()}"
    with tempfile.NamedTemporaryFile("w", suffix=".js") as script:
        script.write(KWIN_SWAP)
        script.flush()
        script_id = qdbus("/Scripting", "org.kde.kwin.Scripting.loadScript", script.name, name)
        qdbus(f"/Scripting/Script{script_id}", "org.kde.kwin.Script.run")
        subprocess.run(launch, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(SWAP_TIMEOUT_S)
        qdbus("/Scripting", "org.kde.kwin.Scripting.unloadScript", name)


if __name__ == "__main__":
    main()
