ACTION=="add", SUBSYSTEM=="video4linux", ATTRS{product}=="Brio 500", RUN+="/usr/bin/v4l2-ctl -d $devnode -c exposure_dynamic_framerate=0"
# Keep the Brio awake: USB autosuspend failed on it ("Failed to suspend device, error -32") and each failure dropped it off USB (archpc, 2026-11-24).
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="0943", TEST=="power/control", ATTR{power/control}="on"
# Turn off USB 2 link power management (LPM) on the Brio: it dropped off USB when an app started its mic after idle (archpc, 2026-11-24).
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="046d", ATTR{idProduct}=="0943", TEST=="power/usb2_hardware_lpm", ATTR{power/usb2_hardware_lpm}="0"
