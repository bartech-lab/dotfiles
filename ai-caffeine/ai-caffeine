#!/usr/bin/env bash
# ai-caffeine — hold OS sleep/lock inhibitors while AI agent processes run.
# Linux: logind block inhibitor (sleep) + temporary KDE auto-lock disable.
#   DPMS blanking stays untouched, so the screen still turns off — it just
#   comes back unlocked, and suspend never triggers.
# macOS: caffeinate -i -w $$ (assertion dies with this process; display sleep
#   stays allowed).
# Fail-safe: the tracked sleep hold expires within ~HOLD seconds if this
# watcher is killed before its cleanup trap can release the hold.

set -u

PROCESSES="${AI_CAFFEINE_PROCESSES:-claude codex omp}"   # space-separated exact process names (comm)
INTERVAL="${AI_CAFFEINE_INTERVAL:-15}"               # seconds between checks
HOLD=$((INTERVAL * 3))                               # hold self-expiry window

LOCKFILE="${AI_CAFFEINE_LOCKFILE:-${TMPDIR:-/tmp}/ai-caffeine.lock}"
STATE="$LOCKFILE.state"                             # original Autolock value while engaged
# flock auto-releases on process death: no stale locks, no restart race where
# the old instance's cleanup deletes the dir under the new instance.
if command -v flock >/dev/null 2>&1; then
    # Legacy mkdir-based versions left a directory here; reclaim it.
    [ -d "$LOCKFILE" ] && rm -rf "$LOCKFILE"
    exec 9>"$LOCKFILE"
    flock -n 9 || exit 0
fi

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$1"
}

have_kconfig() {
    command -v kreadconfig6 >/dev/null 2>&1 && command -v kwriteconfig6 >/dev/null 2>&1
}

# kwin caches Autolock at session start; config writes alone do nothing until
# re-login. configure() makes the running locker re-read kscreenlockerrc.
reconfigure_screensaver() {
    dbus-send --session --print-reply --dest=org.freedesktop.ScreenSaver \
        /ScreenSaver org.kde.screensaver.configure >/dev/null 2>&1 || true
}

restore_autolock() {
    [ -f "$STATE" ] || return 0
    orig="$(cat "$STATE")"
    if [ -n "$orig" ]; then
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock "$orig"
        reconfigure_screensaver
    else
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock --delete
        reconfigure_screensaver
    fi
    rm -f "$STATE"
}

engage_autolock_off() {
    [ -f "$STATE" ] && return 0
    orig="$(kreadconfig6 --file kscreenlockerrc --group Daemon --key Autolock)" || orig=""
    printf '%s' "$orig" > "$STATE"
    kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
    reconfigure_screensaver
    log "engaged: Autolock=false (was ${orig:-unset})"
}

agents_running() {
    # shellcheck disable=SC2086  # word splitting of the name list is intended
    for name in $PROCESSES; do
        pgrep -x "$name" >/dev/null 2>&1 && return 0
    done
    return 1
}

OS="$(uname -s)"

if [ "$OS" = "Linux" ] && have_kconfig; then
    # A previous run may have died while engaged; undo its override first.
    restore_autolock
fi

active=0
holder_pid=""

stop_holder() {
    [ -n "$holder_pid" ] || return 0
    kill "$holder_pid" 2>/dev/null || true
    wait "$holder_pid" 2>/dev/null || true
    holder_pid=""
}

cleanup() {
    stop_holder
    if [ "$OS" = "Linux" ] && have_kconfig; then
        restore_autolock
    fi
}

trap 'cleanup; exit 0' EXIT INT TERM

while true; do
    if agents_running; then
        if [ "$OS" = "Linux" ]; then
            if [ -z "$holder_pid" ] || ! kill -0 "$holder_pid" 2>/dev/null; then
                # No --what=idle: an idle inhibitor makes PowerDevil skip its
                # idle actions (dim, blank) as well as suspend. A finite hold
                # is the fail-safe for SIGKILL or a system crash.
                systemd-inhibit --what=sleep --who=ai-caffeine \
                    --why="AI agent session active" --mode=block sleep "$HOLD" &
                holder_pid=$!
            fi
            if have_kconfig; then
                engage_autolock_off
            fi
        elif [ "$OS" = "Darwin" ]; then
            if [ -z "$holder_pid" ] || ! kill -0 "$holder_pid" 2>/dev/null; then
                caffeinate -i -w "$$" >/dev/null 2>&1 &
                holder_pid=$!
            fi
        fi
        if [ "$active" -eq 0 ]; then
            active=1
            log "engaged: agent process detected"
        fi
    else
        stop_holder
        if [ "$OS" = "Linux" ] && have_kconfig; then
            restore_autolock
        fi
        if [ "$active" -eq 1 ]; then
            active=0
            log "released: no agent processes"
        fi
    fi
    sleep "$INTERVAL"
done
