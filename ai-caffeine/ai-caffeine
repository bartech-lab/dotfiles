#!/usr/bin/env bash
# ai-caffeine — hold OS sleep/lock inhibitors while AI agent processes run.
# Linux: logind block inhibitor (sleep) + temporary KDE auto-lock disable.
#   DPMS blanking stays untouched, so the screen still turns off — it just
#   comes back unlocked, and suspend never triggers.
# macOS: caffeinate -i -w $$ (assertion dies with this process; display sleep
#   stays allowed).
# Fail-safe: holds self-expire within ~HOLD seconds; the auto-lock override is
#   reverted by a state file even if this script dies without running traps.

set -u

PROCESSES="${AI_CAFFEINE_PROCESSES:-claude codex omp}"   # space-separated exact process names (comm)
INTERVAL="${AI_CAFFEINE_INTERVAL:-15}"               # seconds between checks

LOCKFILE="${AI_CAFFEINE_LOCKFILE:-${TMPDIR:-/tmp}/ai-caffeine.lock}"
STATE="$LOCKFILE.state"                             # original Autolock value while engaged
# flock auto-releases on process death: no stale locks, no restart race where
# the old instance's cleanup deletes the dir under the new instance.
if command -v flock >/dev/null 2>&1; then
    # Legacy mkdir-based versions left a directory here; reclaim it.
    [ -d "$LOCKFILE" ] && rm -rf "$LOCKFILE"
    exec 9>"$LOCKFILE"
    flock -n 9 || exit 0
fi

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$1"
}

have_kconfig() {
    command -v kreadconfig6 >/dev/null 2>&1 && command -v kwriteconfig6 >/dev/null 2>&1
}

# kwin caches Autolock at session start. Plain kwriteconfig6 does not emit the
# KConfig D-Bus change notification, so live reload is racy — always pass
# --notify, and call configure() as a belt-and-braces re-read.
reconfigure_screensaver() {
    dbus-send --session --print-reply --dest=org.freedesktop.ScreenSaver \
        /ScreenSaver org.kde.screensaver.configure >/dev/null 2>&1 || true
}

restore_autolock() {
    [ -f "$STATE" ] || return 0
    orig="$(cat "$STATE")"
    if [ -n "$orig" ]; then
        kwriteconfig6 --notify --file kscreenlockerrc --group Daemon --key Autolock "$orig"
        reconfigure_screensaver
    else
        kwriteconfig6 --notify --file kscreenlockerrc --group Daemon --key Autolock --delete
        reconfigure_screensaver
    fi
}

engage_autolock_off() {
    [ -f "$STATE" ] && return 0
    orig="$(kreadconfig6 --file kscreenlockerrc --group Daemon --key Autolock)" || orig=""
    printf '%s' "$orig" > "$STATE"
    kwriteconfig6 --notify --file kscreenlockerrc --group Daemon --key Autolock false
    reconfigure_screensaver
    log "engaged: Autolock=false (was ${orig:-unset})"
}

INHIBIT_FIFO="$LOCKFILE.inhibit-fifo"
inhibit_pid=""
inh_fd=""

agents_running() {
    # shellcheck disable=SC2086  # word splitting of the name list is intended
    for name in $PROCESSES; do
        pgrep -x "$name" >/dev/null 2>&1 && return 0
    done
    return 1
}

# Hold ONE logind inhibitor for the whole engagement. Recreating it every
# cycle makes PowerDevil reset its dim/DPMS idle timers on each
# InhibitionsChanged, so they can never fire while an agent runs.
# The child exits when this process dies (fifo write-end closes) or when a
# byte is written into the fifo — self-releasing either way.
start_inhibit() {
    if [ -n "$inhibit_pid" ] && kill -0 "$inhibit_pid" 2>/dev/null; then
        return 0
    fi
    inhibit_pid=""
    rm -f "$INHIBIT_FIFO"
    mkfifo "$INHIBIT_FIFO" || return 1
    systemd-inhibit --what=sleep --who=ai-caffeine \
        --why="AI agent session active" --mode=block \
        bash -c 'head -c 1 "$1" >/dev/null 2>&1' _ "$INHIBIT_FIFO" &
    inhibit_pid=$!
    exec {inh_fd}>"$INHIBIT_FIFO" || { kill "$inhibit_pid" 2>/dev/null; inhibit_pid=""; return 1; }
}

stop_inhibit() {
    if [ -n "$inhibit_pid" ] && kill -0 "$inhibit_pid" 2>/dev/null; then
        { printf 'x' >&"$inh_fd"; } 2>/dev/null || true
    fi
    [ -n "$inh_fd" ] && eval "exec ${inh_fd}>&-" 2>/dev/null
    inh_fd=""
    if [ -n "$inhibit_pid" ]; then
        wait "$inhibit_pid" 2>/dev/null
        inhibit_pid=""
    fi
}

OS="$(uname -s)"

if [ "$OS" = "Linux" ] && have_kconfig; then
    # A previous run may have died while engaged; undo its override first.
    restore_autolock
fi
trap 'restore_autolock 2>/dev/null; stop_inhibit 2>/dev/null; exit 0' EXIT INT TERM

active=0
holder_pid=""

while true; do
    if agents_running; then
        if [ "$OS" = "Linux" ]; then
            start_inhibit
            if have_kconfig; then
                engage_autolock_off
            fi
        elif [ "$OS" = "Darwin" ]; then
            if [ -z "$holder_pid" ] || ! kill -0 "$holder_pid" 2>/dev/null; then
                caffeinate -i -w "$$" >/dev/null 2>&1 &
                holder_pid=$!
            fi
        fi
        if [ "$active" -eq 0 ]; then
            active=1
            log "engaged: agent process detected"
        fi
    else
        if [ "$OS" = "Darwin" ] && [ -n "$holder_pid" ] && kill -0 "$holder_pid" 2>/dev/null; then
            kill "$holder_pid" 2>/dev/null
            wait "$holder_pid" 2>/dev/null
        fi
        holder_pid=""
        if [ "$OS" = "Linux" ]; then
            restore_autolock
            stop_inhibit
        fi
        if [ "$active" -eq 1 ]; then
            active=0
            log "released: no agent processes"
        fi
    fi
    sleep "$INTERVAL"
done
