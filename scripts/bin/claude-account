#!/usr/bin/env bash
# Run Claude Code on one of two subscription accounts, side by side. Invoked
# through its links: `claude` (scripts/shims, ahead of ~/.local/bin in PATH) and
# `wclaude` (scripts/bin). The case block below maps each name to an account;
# swap its two account values to swap which account plain `claude` uses.
#
# work    the default config: ~/.claude and ~/.claude.json.
# private its own CLAUDE_CONFIG_DIR at ~/.claude-private, so its login is
#         separate: macOS keeps it in a Keychain item keyed by the directory
#         path, Linux in ~/.claude-private/.credentials.json. Everything else is
#         shared with ~/.claude through symlinks refreshed on every launch:
#         settings, hooks, skills, plugins, sessions, history and project memory.
#         Directories are shared unless excluded; top-level files only when
#         listed in SHARED_FILES, because Claude Code saves state files by
#         rename, which replaces a symlink. User and project MCP servers, trust
#         and allowed tools are copied from ~/.claude.json on every launch.
#         claudeInChromeDefaultEnabled is not copied: Chrome can be on for the
#         private account only.
#
# A plain `claude` started under a session (cc-relay, tfg-run, `!` commands)
# keeps that session's account through CLAUDE_ACCOUNT. Export
# CLAUDE_ACCOUNT=work|private to pick the account of plain `claude` in a shell.
#
# Usage: claude [claude args...]     wclaude [claude args...]
#   first run on an account: type /login and sign in
#   claude mcp add ...      MCP changes go to the shared ~/.claude.json

set -euo pipefail

base="$HOME/.claude"
profile="$HOME/.claude-private"

# Login, account and runtime state that must stay per account.
EXCLUDE=(
    .credentials.json
    .claude.json
    .DS_Store
    backups
    policy-limits.json
    policy-limits.json.stamp.json
    remote-settings.json
    remote-settings.json.synced-at
    mcp-needs-auth-cache.json
    stats-cache.json
    daemon
    daemon.log
    sessions
    jobs
    bridge-spawn
    seed-admin
    .cc-writes
)

# Top-level files to share. Any other file is per-account state.
SHARED_FILES=(
    settings.json
    settings.local.json
    CLAUDE.md
    statusline-command.sh
    history.jsonl
)

case ${0##*/} in
    claude) account=${CLAUDE_ACCOUNT:-private} ;;
    wclaude) account=work ;;
    *) echo "claude-account: run it as claude or wclaude" >&2; exit 2 ;;
esac
[[ $account == work || $account == private ]] \
    || { echo "claude-account: CLAUDE_ACCOUNT must be work or private, not '$account'" >&2; exit 2; }

# The first claude in PATH that is not this script.
self=$(readlink -f "$0")
real=
IFS=: read -ra path_dirs <<< "$PATH"
for d in "${path_dirs[@]}"; do
    c="${d:-.}/claude"
    if [[ -f $c && -x $c && $(readlink -f "$c") != "$self" ]]; then
        real=$c
        break
    fi
done
[[ -n $real ]] || { echo "claude-account: no claude binary in PATH" >&2; exit 127; }

export CLAUDE_ACCOUNT=$account
if [[ $account == work || ${1:-} == mcp ]]; then
    unset CLAUDE_CONFIG_DIR
    exec "$real" "$@"
fi

shopt -s nullglob
mkdir -p "$profile"
chmod 700 "$profile"

excluded() {
    local e
    for e in "${EXCLUDE[@]}"; do
        [[ $1 == "$e" ]] && return 0
    done
    return 1
}

shared_file() {
    local f
    for f in "${SHARED_FILES[@]}"; do
        [[ $1 == "$f" ]] && return 0
    done
    return 1
}

for dst in "$profile"/* "$profile"/.[!.]*; do
    # Drop a link whose source was removed.
    [[ -L $dst ]] || continue
    if [[ ! -e $dst ]]; then
        rm "$dst"
    elif [[ -f $dst && $(readlink "$dst") == "$base/"* ]] && ! shared_file "${dst##*/}"; then
        rm "$dst"
    fi
done

for src in "$base"/* "$base"/.[!.]*; do
    [[ -e $src || -L $src ]] || continue
    name=${src##*/}
    excluded "$name" && continue
    [[ -f $src ]] && ! shared_file "$name" && continue
    dst="$profile/$name"
    if [[ -L $dst ]]; then
        continue
    elif [[ -e $dst ]]; then
        echo "claude: $dst is a local copy, not a link to $src; delete it to share again" >&2
    else
        ln -s "$src" "$dst"
    fi
done

python3 - "$HOME/.claude.json" "$profile/.claude.json" <<'PY'
import json, os, sys, tempfile

GLOBAL_KEYS = (
    "mcpServers",
    "autoUpdates",
    "autoUpdatesProtectedForNative",
    "installMethod",
    "hasCompletedClaudeInChromeOnboarding",
    "cachedChromeExtensionInstalled",
    "deepLinkTerminal",
    "githubRepoPaths",
    "codeReviewLastEffort",
    "diffSidebarOpen",
    "showExpandedTodos",
)
PROJECT_KEYS = (
    "mcpServers",
    "enabledMcpjsonServers",
    "disabledMcpjsonServers",
    "disabledMcpServers",
    "mcpContextUris",
    "allowedTools",
    "hasTrustDialogAccepted",
    "hasClaudeMdExternalIncludesApproved",
    "hasClaudeMdExternalIncludesWarningShown",
)

src_path, dst_path = sys.argv[1], sys.argv[2]
try:
    with open(src_path) as f:
        src = json.load(f)
except FileNotFoundError:
    sys.exit(0)
try:
    with open(dst_path) as f:
        dst = json.load(f)
except FileNotFoundError:
    dst = {}
before = json.dumps(dst, sort_keys=True)

for key in GLOBAL_KEYS:
    if key in src:
        dst[key] = src[key]
    else:
        dst.pop(key, None)

projects = dst.setdefault("projects", {})
for path, sp in src.get("projects", {}).items():
    dp = projects.setdefault(path, {})
    for key in PROJECT_KEYS:
        if key in sp:
            dp[key] = sp[key]
        else:
            dp.pop(key, None)
for path in [p for p in projects if p not in src.get("projects", {}) and not os.path.isdir(p)]:
    del projects[path]

if json.dumps(dst, sort_keys=True) == before:
    sys.exit(0)

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dst_path), prefix=".claude.json.")
with os.fdopen(fd, "w") as f:
    json.dump(dst, f, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, dst_path)
PY

export CLAUDE_CONFIG_DIR="$profile"

# ~/.claude-private/projects is a symlink, and Claude Code asks before writing
# through one, even in auto mode and with allow rules or an allow hook. Naming
# the real memory folder removes the prompt. It takes one path, so set it here
# per project, with the same folder name Claude Code derives.
root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && root=${root%/.git} || root=$PWD
exec "$real" --settings "{\"autoMemoryDirectory\":\"$base/projects/${root//[^[:alnum:]]/-}/memory\"}" "$@"
