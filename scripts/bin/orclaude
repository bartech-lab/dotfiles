#!/bin/zsh

if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
  print -u2 "orclaude: OPENROUTER_API_KEY is not set"
  print -u2 "Add it to your local ~/.zshenv, then reload the shell."
  exit 1
fi

# Defaults independent of plain `claude`, which reads ~/.claude/settings.json.
# Override per launch: ORCLAUDE_MODEL=... ORCLAUDE_EFFORT=high orclaude
: "${ORCLAUDE_MODEL:=stealth/ox-alpha}"
: "${ORCLAUDE_EFFORT:=high}"

export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_API_KEY=""
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="1000000"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="900000"

export ANTHROPIC_MODEL="$ORCLAUDE_MODEL"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$ORCLAUDE_MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$ORCLAUDE_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$ORCLAUDE_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$ORCLAUDE_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$ORCLAUDE_MODEL"

# Env var and flag both pin effort: the flag wins if the user passes their own.
export CLAUDE_CODE_EFFORT_LEVEL="$ORCLAUDE_EFFORT"
exec claude --effort "$ORCLAUDE_EFFORT" "$@"
